{
  "name": "kosuke-template",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:email": "concurrently \"bun run dev\" \"bun run email:dev\"",
    "dev:all": "concurrently \"bun run dev\" \"bun run workers:dev\"",
    "workers:dev": "bun tsx --watch -r dotenv/config worker.ts",
    "workers:start": "bun tsx -r dotenv/config worker.ts",
    "prebuild": "bun run db:migrate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint-staged": "lint-staged",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run lib/db/scripts/db-seed.ts",
    "db:reset": "bun run lib/db/scripts/db-reset.ts",
    "db:create-admin-user": "bun run lib/db/scripts/db-create-admin-user.ts",
    "stripe:seed": "bun run lib/db/scripts/stripe-seed.ts",
    "email:dev": "email dev --dir emails --port 3001",
    "email:export": "email export --dir emails --out .react-email",
    "shadcn:update": "bun shadcn@canary add -a -y -o",
    "shadcn:check": "bun shadcn@canary diff",
    "knip": "knip"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/react": "^4.0.102",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.34.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/components": "^1.0.12",
    "@react-email/tailwind": "^2.0.7",
    "@sentry/nextjs": "^10.74.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.18.0",
    "@trpc/next": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/pg": "^8.23.1",
    "ai": "^7.0.99",
    "better-auth": "^1.7.4",
    "bullmq": "^5.66.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.26",
    "input-otp": "^1.5.0",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.562.0",
    "nanoid": "^5.1.6",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.3.0",
    "react-email": "^5.1.1",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "2.15.4",
    "resend": "^6.28.0",
    "sonner": "^2.0.8",
    "streamdown": "^1.6.10",
    "stripe": "^20.1.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "zod": "^4.6.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.63.0",
    "@react-email/preview-server": "5.0.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.1.3",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9",
    "jsdom": "25.0.1",
    "knip": "^5.45.3",
    "lint-staged": "^15.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "vitest related --run"
    ],
    "*.{yml,yaml,md,json}": [
      "prettier --write"
    ]
  }
}
